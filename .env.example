# Copy to .env (cp .env.example .env). Never commit the real .env.
# Local development (pnpm dev, pnpm seed) reads these directly.
# docker compose overrides MONGODB_URI so the containers reach the mongo service.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27017/finance

# Signs login tokens. Replace before deploying with a long random value, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=local-development-secret-replace-me-before-deploying
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_ATTEMPTS_PER_MINUTE=5

# Password for the four seeded demo users. It is shown on the login page on purpose.
DEMO_PASSWORD=Analyst@2024

# Copy to .env (cp .env.example .env). Never commit the real .env.
# Local development (pnpm dev, pnpm seed) reads these directly.
# docker compose overrides MONGODB_URI so the containers reach the mongo service.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27017/finance

# Password for the four seeded demo users. It is shown on the login page on purpose.
DEMO_PASSWORD=Analyst@2024
